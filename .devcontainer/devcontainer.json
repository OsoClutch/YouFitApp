{
  "name": "YouFit",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "postCreateCommand": "npm ci",
  "forwardPorts": [5173, 8788],
  "portsAttributes": {
    "5173": { "label": "Vite dev", "onAutoForward": "openBrowser" },
    "8788": { "label": "Pages Functions (wrangler)", "onAutoForward": "silent" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["dbaeumer.vscode-eslint"],
      "settings": {
        "editor.formatOnSave": false
      }
    }
  },
  "remoteEnv": {
    "//": "FAL_KEY is read from a Codespaces secret. Set it at github.com/settings/codespaces.",
    "FAL_KEY": "${localEnv:FAL_KEY}"
  }
}
